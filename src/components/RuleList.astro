---
import Icon from './Icon.astro';
import { DIMENSION_INFO, RULE_AREA_LABEL, RULE_CONDITION_INFO, RULE_STATUS_INFO, USE_INFO } from '../lib/labels';
import { DIMENSIONS, USES, type OtherRule, type Quote, type Rule, type RuleArea, type RuleStatus, type Source } from '../lib/schema';

interface Props {
  rules: Rule[];
  otherRules: OtherRule[];
  sources: Source[];
}

const { rules, otherRules, sources } = Astro.props;

/** Status badge colours reuse the mood tones: yes, yes with conditions, advised against, no. */
const statusTone: Record<RuleStatus, string> = {
  allowed: 'tone-friendly',
  conditional: 'tone-mostly-friendly',
  discouraged: 'tone-unknown',
  'not-allowed': 'tone-unfriendly',
};
const sourceTitle = (url: string) => sources.find((s) => s.url === url)?.title ?? url;
const ordered = [...rules].sort((a, b) => USES.indexOf(a.use) - USES.indexOf(b.use));
const groups = DIMENSIONS.map((dim) => ({
  dim,
  rules: ordered.filter((r) => USE_INFO[r.use].area === dim),
  other: otherRules.filter((o) => o.area === dim),
  missing: USES.filter((u) => USE_INFO[u].area === dim && !rules.some((r) => r.use === u)),
}));
const general = otherRules.filter((o) => o.area === 'general');

type Item = { title: string; status: RuleStatus; note: string; conditions: Rule['conditions']; quotes: Quote[] };
const fromRule = (r: Rule): Item => ({ title: USE_INFO[r.use].label, status: r.status, note: r.note, conditions: r.conditions, quotes: r.quotes });
const fromOther = (o: OtherRule, area: RuleArea): Item => ({
  title: area === 'general' ? 'Other rule' : `Other ${RULE_AREA_LABEL[area].toLowerCase()} rule`,
  status: o.status,
  note: o.description,
  conditions: [],
  quotes: o.quotes,
});
---

{
  groups.map((g) => (
    <div class="mt-6 first:mt-0">
      <h3 class="mb-1 flex items-center gap-2 font-semibold">
        <Icon name={DIMENSION_INFO[g.dim].icon} size={14} class="text-faint" />
        {DIMENSION_INFO[g.dim].label}
      </h3>
      {g.rules.length + g.other.length > 0 ? (
        <ul class="divide-y divide-line border-y border-line">
          {[...g.rules.map(fromRule), ...g.other.map((o) => fromOther(o, g.dim))].map((item) => (
            <li class="flex gap-3 py-3">
              <span
                class:list={[statusTone[item.status], 'mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-(--tone) text-face']}
                title={RULE_STATUS_INFO[item.status].label}
              >
                <Icon name={RULE_STATUS_INFO[item.status].icon} size={14} />
              </span>
              <div class="min-w-0">
                <p>
                  <strong class="font-semibold">{item.title}</strong>
                  <span class="text-muted"> · {RULE_STATUS_INFO[item.status].label}</span>
                </p>
                <p class="mt-0.5 text-sm text-muted">{item.note}</p>
                {item.conditions.length > 0 && (
                  <ul class="mt-2 flex flex-col gap-1 text-sm" aria-label="Conditions">
                    {item.conditions.map((c) => (
                      <li class="flex items-start gap-1.5">
                        <Icon name={RULE_CONDITION_INFO[c.condition].icon} size={13} class="mt-1 text-faint" />
                        <span>
                          {RULE_CONDITION_INFO[c.condition].label}
                          {c.detail && <span class="text-muted">: {c.detail}</span>}
                          {c.strength === 'recommended' && <span class="text-muted"> (recommended, not required)</span>}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
                <details class="mt-2 text-sm">
                  <summary class="cursor-pointer text-muted">
                    {item.quotes.length === 1 ? 'Quote' : `${item.quotes.length} quotes`}
                  </summary>
                  {item.quotes.map((q) => (
                    <figure class="mt-2 flex gap-2.5">
                      <Icon name="quote" size={13} class="mt-1 text-faint" />
                      <div>
                        <blockquote cite={q.sourceUrl}>
                          <p>{q.quote}</p>
                        </blockquote>
                        <figcaption class="mt-0.5 text-caption">
                          <a href={q.sourceUrl} rel="noopener" class="text-muted">
                            {sourceTitle(q.sourceUrl)}
                          </a>
                        </figcaption>
                      </div>
                    </figure>
                  ))}
                </details>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="border-y border-line py-3 text-sm text-muted">The policy does not cover this area.</p>
      )}
      {g.missing.length > 0 && g.rules.length + g.other.length > 0 && (
        <details class="mt-2 text-sm">
          <summary class="cursor-pointer text-muted">Not covered by the policy ({g.missing.length})</summary>
          <p class="mt-1.5 text-muted">{g.missing.map((u) => USE_INFO[u].label).join(', ')}.</p>
        </details>
      )}
    </div>
  ))
}
{
  general.length > 0 && (
    <div class="mt-6">
      <h3 class="mb-1 font-semibold">{RULE_AREA_LABEL.general}</h3>
      <ul class="divide-y divide-line border-y border-line">
        {general.map((o) => (
          <li class="flex gap-3 py-3">
            <span
              class:list={[statusTone[o.status], 'mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-(--tone) text-face']}
              title={RULE_STATUS_INFO[o.status].label}
            >
              <Icon name={RULE_STATUS_INFO[o.status].icon} size={14} />
            </span>
            <div class="min-w-0">
              <p>{o.description}</p>
              {o.quotes.map((q) => (
                <p class="mt-1 text-sm text-muted">
                  “{q.quote}” (<a href={q.sourceUrl} rel="noopener" class="text-muted">{sourceTitle(q.sourceUrl)}</a>)
                </p>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </div>
  )
}
