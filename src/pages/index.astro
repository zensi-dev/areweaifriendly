---
import Icon from '../components/Icon.astro';
import MoodTile from '../components/MoodTile.astro';
import Layout from '../layouts/Layout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { CATEGORY_INFO, DIMENSION_INFO, STANCE_INFO } from '../lib/labels';
import { formatDate, lastUpdated, projects, stanceCounts } from '../lib/projects';
import { CATEGORIES, DIMENSIONS } from '../lib/schema';
import { moodSample, STANCES } from '../lib/stance';
import { SITE_DESCRIPTION, SITE_NAME, SITE_URL } from '../site.config';
import { AREA_COLUMNS, LIST_COLUMNS, LIST_PAGE_SIZE, VERDICT_WIDTH, WIDE } from '../lib/ui';

const counts = stanceCounts();
const total = projects.length;
const shownStances = STANCES.filter((s) => counts[s] > 0);
const categories = CATEGORIES.filter((c) => projects.some((p) => p.category === c));

// Past 48 projects the grid shows a proportional sample of the newest, so it stays short on phones.
const byMood = moodSample(projects, 48);
const sampled = byMood.length < total;
// Keep the mood grid compact as it grows; full class names so Tailwind finds them.
const moodGrid =
  byMood.length <= 10
    ? { cols: 'grid-cols-5', tile: 'md' as const }
    : byMood.length <= 40
      ? { cols: 'grid-cols-8', tile: 'md' as const }
      : { cols: 'grid-cols-8 sm:grid-cols-12', tile: 'sm' as const };
const pagerButton =
  'inline-flex h-9 cursor-pointer items-center gap-1 rounded-md border border-line-strong bg-surface px-3 text-sm font-medium hover:border-ink disabled:cursor-default disabled:opacity-40 disabled:hover:border-line-strong';
const field =
  'h-11 w-full rounded-md border border-line-strong bg-surface text-[0.9375rem] placeholder:text-faint focus:border-accent focus:ring-2 focus:ring-accent/25 focus:outline-none';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: SITE_NAME, url: `${SITE_URL}/`, description: SITE_DESCRIPTION },
    {
      '@type': 'Dataset',
      name: 'Open source AI contribution policies',
      description: SITE_DESCRIPTION,
      url: `${SITE_URL}/`,
      isAccessibleForFree: true,
      dateModified: lastUpdated(),
      distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE_URL}/projects.json` }],
    },
  ],
};
---

<Layout
  title={SITE_NAME}
  description={SITE_DESCRIPTION}
  markdown="/llms.txt"
  jsonLd={jsonLd}
>
  <section class:list={[WIDE, 'grid items-center gap-x-12 gap-y-8 pt-12 pb-10 md:grid-cols-[minmax(0,1fr)_auto] md:pt-20']}>
    <div>
      <h1 class="casual text-5xl leading-[1.05] font-extrabold tracking-tight sm:text-6xl">Are we AI friendly?</h1>
      <p class="mt-5 max-w-[52ch] text-lg text-muted">
        How open source projects react to AI-assisted pull requests, bug reports and comments, based on their own
        published policies.
      </p>
    </div>

    <div>
      <ul
        class:list={['grid w-fit gap-1.5', moodGrid.cols]}
        aria-label={sampled
          ? `${byMood.length} of ${total} tracked projects, in proportion, by how friendly they are`
          : 'Every tracked project, by how friendly it is'}
      >
        {
          byMood.map((p) => (
            <li>
              <a
                href={`#${p.slug}`}
                class="block rounded-[10px] no-underline"
                title={`${p.name}: ${STANCE_INFO[p.stance].label}`}
                aria-label={`${p.name}: ${STANCE_INFO[p.stance].label}`}
              >
                <MoodTile stance={p.stance} size={moodGrid.tile} decorative />
              </a>
            </li>
          ))
        }
      </ul>
      {sampled && <p class="mt-2 text-caption text-muted" aria-hidden="true">{byMood.length} of {total} projects, in proportion</p>}
      <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Filter by friendliness">
        {
          shownStances.map((s) => (
            <button
              type="button"
              class="inline-flex cursor-pointer items-center gap-2 rounded-md border border-line-strong bg-surface py-1 pr-2.5 pl-1 text-sm hover:border-ink aria-pressed:border-ink aria-pressed:ring-1 aria-pressed:ring-ink"
              data-chip={s}
              aria-pressed="false"
              title={STANCE_INFO[s].meaning}
            >
              <MoodTile stance={s} size="xs" decorative />
              <span class="font-medium">{STANCE_INFO[s].label}</span>
              <span class="text-muted tabular-nums">{counts[s]}</span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section id="list" class={WIDE} aria-labelledby="list-title">
    <h2 id="list-title" class="sr-only" tabindex="-1">Projects</h2>
    <div class="flex flex-col gap-2.5 bg-paper py-3 sm:sticky sm:top-0 sm:z-10 sm:flex-row">
      <label class="relative grow">
        <span class="sr-only">Search projects</span>
        <Icon name="search" size={16} class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-faint" />
        <input id="q" type="search" placeholder="Search projects" autocomplete="off" spellcheck="false" class:list={[field, 'pr-10 pl-9']} />
        <kbd
          class="absolute top-1/2 right-2.5 hidden -translate-y-1/2 rounded border border-line-strong px-1.5 text-xs text-muted sm:block"
          aria-hidden="true">/</kbd
        >
      </label>
      <label class="shrink-0 sm:basis-56">
        <span class="sr-only">Category</span>
        <select id="category" class:list={[field, 'cursor-pointer px-3']}>
          <option value="">All categories</option>
          {categories.map((c) => <option value={c}>{CATEGORY_INFO[c]}</option>)}
        </select>
      </label>
    </div>

    <div class="mt-3">
      <div
        class:list={['hidden items-center gap-x-3 rounded-lg bg-surface px-3 py-2 text-caption font-medium text-muted md:grid', LIST_COLUMNS]}
        aria-hidden="true"
      >
        <span class="col-start-2">Project</span>
        <span class={AREA_COLUMNS}>
          {
            DIMENSIONS.map((d) => (
              <span class="inline-flex cursor-help items-center gap-1.5" title={DIMENSION_INFO[d].meaning}>
                <Icon name={DIMENSION_INFO[d].icon} size={13} class="hidden text-faint lg:block" />
                {DIMENSION_INFO[d].short}
              </span>
            ))
          }
        </span>
        <span class:list={[VERDICT_WIDTH, 'justify-self-end']}>Friendly?</span>
      </div>
      <ul id="projects">
        {projects.map((p, i) => <ProjectRow project={p} hidden={i >= LIST_PAGE_SIZE} />)}
      </ul>
      {/* Without the script every row shows. Same layer as Tailwind's important [hidden] rule, which outranks unlayered styles. */}
      <noscript><style is:inline>@layer base { #projects > li[hidden] { display: list-item !important; } }</style></noscript>
      <p id="empty" class="px-3 py-12 text-center text-muted" hidden>
        No project matches. Know one that belongs here? <a href="/about/#add">Add it</a>.
      </p>
    </div>

    <nav id="pager" class="mt-6 flex items-center justify-between gap-3" aria-label="Project pages" hidden>
      <button type="button" class:list={[pagerButton, 'pl-2']} data-step="-1">
        <Icon name="chevron-right" size={16} class="rotate-180" />Previous
      </button>
      <ol id="page-numbers" class="flex items-center gap-1 max-sm:hidden"></ol>
      <span id="page-of" class="text-sm text-muted tabular-nums sm:hidden"></span>
      <button type="button" class:list={[pagerButton, 'pr-2']} data-step="1">
        Next<Icon name="chevron-right" size={16} />
      </button>
    </nav>

    <p class="mt-4 text-caption text-muted" aria-live="polite">
      <span id="status">Showing all {total} projects.</span> Updated {formatDate(lastUpdated())}.
    </p>
  </section>
</Layout>

<script>
  import { queryTerms, rankMatches } from '../lib/search';
  import { LIST_PAGE_SIZE } from '../lib/ui';

  const q = document.querySelector<HTMLInputElement>('#q')!;
  const category = document.querySelector<HTMLSelectElement>('#category')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-chip]')];
  const projectList = document.querySelector<HTMLUListElement>('#projects')!;
  const rows = [...projectList.children] as HTMLLIElement[];
  const status = document.querySelector('#status')!;
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const list = document.querySelector<HTMLElement>('#list')!;
  const listTitle = document.querySelector<HTMLElement>('#list-title')!;
  const pager = document.querySelector<HTMLElement>('#pager')!;
  const pageNumbers = document.querySelector('#page-numbers')!;
  const pageOf = document.querySelector('#page-of')!;
  const [prev, next] = [...pager.querySelectorAll<HTMLButtonElement>('[data-step]')];
  const stances = new Set<string>();
  let matches = rows;
  let page = 1;

  function matchesFilters(row: HTMLLIElement) {
    return (!category.value || row.dataset.category === category.value) && (!stances.size || stances.has(row.dataset.stance!));
  }

  /** Page numbers to show: first, last, current and its neighbours; null marks a gap. */
  function pageItems(count: number) {
    const keep = [...new Set([1, page - 1, page, page + 1, count])].filter((n) => n >= 1 && n <= count).sort((a, b) => a - b);
    const items: (number | null)[] = [];
    let last = 0;
    for (const n of keep) {
      if (n - last === 2) items.push(last + 1);
      else if (n - last > 2) items.push(null);
      items.push(n);
      last = n;
    }
    return items;
  }

  function render() {
    const count = Math.max(1, Math.ceil(matches.length / LIST_PAGE_SIZE));
    page = Math.min(Math.max(1, page), count);
    const start = (page - 1) * LIST_PAGE_SIZE;
    const visible = matches.slice(start, start + LIST_PAGE_SIZE);
    const shown = new Set(visible);
    for (const row of rows) row.hidden = !shown.has(row);
    // Ranked results reorder the rows; append keeps nodes, so open details stay open.
    projectList.append(...visible);

    const end = start + visible.length;
    status.textContent = !matches.length
      ? `No matches among ${rows.length} projects.`
      : `Showing ${start + 1}–${end} of ${matches.length} ${matches.length === rows.length ? 'projects' : `matching projects (${rows.length} total)`}.`;
    empty.hidden = matches.length > 0;
    for (const chip of chips) chip.setAttribute('aria-pressed', String(stances.has(chip.dataset.chip!)));

    pager.hidden = count < 2;
    prev.disabled = page === 1;
    next.disabled = page === count;
    pageOf.textContent = `Page ${page} of ${count}`;
    pageNumbers.replaceChildren(
      ...pageItems(count).map((n) => {
        const li = document.createElement('li');
        if (n === null) {
          li.className = 'px-1 text-muted';
          li.textContent = '…';
          li.setAttribute('aria-hidden', 'true');
          return li;
        }
        const button = document.createElement('button');
        button.type = 'button';
        button.className =
          'h-9 min-w-9 cursor-pointer rounded-md px-2 text-sm font-medium tabular-nums hover:bg-surface aria-[current=page]:bg-ink aria-[current=page]:text-paper';
        button.dataset.page = String(n);
        button.textContent = String(n);
        button.setAttribute('aria-label', `Page ${n}`);
        if (n === page) button.setAttribute('aria-current', 'page');
        li.append(button);
        return li;
      }),
    );

    const params = new URLSearchParams();
    if (q.value.trim()) params.set('q', q.value.trim());
    if (category.value) params.set('category', category.value);
    if (stances.size) params.set('stance', [...stances].join(','));
    if (page > 1) params.set('page', String(page));
    const query = params.toString();
    history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
  }

  // With a query, best matches come first; without one the list keeps its newest-first order.
  function filter() {
    const terms = queryTerms(q.value);
    const filtered = rows.filter(matchesFilters);
    matches = terms.length ? rankMatches(filtered, terms, (row) => ({ name: row.dataset.name!, text: row.dataset.search! })) : filtered;
  }

  function apply() {
    filter();
    page = 1;
    render();
  }

  function goTo(n: number) {
    page = n;
    render();
    listTitle.focus({ preventScroll: true });
    list.scrollIntoView({ block: 'start' });
  }

  const params = new URLSearchParams(location.search);
  q.value = params.get('q') ?? '';
  category.value = params.get('category') ?? '';
  for (const s of params.get('stance')?.split(',') ?? []) if (chips.some((c) => c.dataset.chip === s)) stances.add(s);

  q.addEventListener('input', apply);
  category.addEventListener('change', apply);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const s = chip.dataset.chip!;
      if (!stances.delete(s)) stances.add(s);
      apply();
    });
  }
  pager.addEventListener('click', (e) => {
    const button = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!button || button.disabled) return;
    goTo(button.dataset.page ? Number(button.dataset.page) : page + Number(button.dataset.step));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      q.focus();
    } else if (e.key === 'Escape' && document.activeElement === q && q.value) {
      q.value = '';
      apply();
    }
  });

  // Mood-grid links point at a row that may sit on another page or be hidden by the filters.
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    const row = rows.find((r) => r.id === id);
    if (!row) return;
    if (!matches.includes(row)) {
      q.value = '';
      category.value = '';
      stances.clear();
      matches = rows;
    }
    page = Math.floor(matches.indexOf(row) / LIST_PAGE_SIZE) + 1;
    render();
    row.querySelector('details')!.open = true;
    row.scrollIntoView({ block: 'start' });
  }
  window.addEventListener('hashchange', openFromHash);

  filter();
  page = Number(params.get('page')) || 1;
  render();
  openFromHash();
</script>
