# Any OpenAI-compatible chat completions endpoint (OpenAI, OpenRouter, Groq, Ollama, GitHub Models, ...).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
# "json_schema" (strict structured output) or "json_object" for providers without schema support.
AI_RESPONSE_FORMAT=json_schema
# Safety cap on characters sent per classification (all sources combined).
AI_MAX_INPUT_CHARS=300000
